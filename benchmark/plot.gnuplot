#!/usr/bin/env gnuplot
#
# Renders benchmark/results.dat (produced by h2load_matrix.sh) into two PNGs:
#   heatmap.png  - req/s as color over the full (-c, -m) grid
#   lines.png    - req/s vs -m, one line per -c value
#
# Run from the benchmark/ directory: gnuplot plot.gnuplot

set datafile missing "?"
set macros

# 'sweep' (space-separated, drives the per-c line loop via word()) and
# 'tics_list' (macro-expanded, explicit tic marks so labels line up with the
# actual, non-uniformly spaced, samples) are generated by h2load_matrix.sh --
# that script's VALUES array is the single source of truth, not this file
load 'sweep_values.gnuplot'

set terminal pngcairo size 1100,850 enhanced font "sans,11"

# ---------------------------------------------------------------------------
# Heatmap: -c vs -m vs req/s
# ---------------------------------------------------------------------------
set output 'heatmap.png'
set title "h2load throughput over -c / -m" font "sans,14"
set xlabel "-c  (clients)"
set ylabel "-m  (concurrent streams per client)"
set cblabel "requests/s"

# set logscale x 2
# set logscale y 2
set xtics @tics_list rotate by -45
set ytics @tics_list
set format x "%g"
set format y "%g"
unset key

# multi-hue sequential ramp (near-zero -> blue -> aqua -> yellow -> orange ->
# red), built from the palette's own validated categorical hues in increasing-
# value order -- gives far more differentiation across a saturating plateau
# than a single-hue ramp would
set palette defined (\
    0.00 '#cde2fb', \
    0.15 '#3987e5', \
    0.35 '#1baf7a', \
    0.55 '#eda100', \
    0.75 '#eb6834', \
    1.00 '#e34948' \
)

# pm3d fills the true (non-uniform) quad between neighboring grid points, so
# unlike fixed-size point markers it leaves no gaps at the widely-log-spaced
# low end of the sweep; thin surface-colored borders stand in for the 2px
# gap-between-fills the mark spec calls for
set pm3d map
set pm3d corners2color c1
set pm3d border linecolor rgb '#fcfcfb' linewidth 0.6

splot 'results.dat' using 1:2:3 with pm3d

# ---------------------------------------------------------------------------
# Line plot: req/s vs -m, one line per -c (colored by an ordinal blue ramp,
# read via the colorbox instead of a 17-entry key)
# ---------------------------------------------------------------------------
set output 'lines.png'
set title "h2load throughput vs -m, by client count -c" font "sans,14"
set xlabel "-m  (concurrent streams per client)"
set ylabel "requests/s"
set cblabel "-c  (clients)"

# unset logscale y
set ytics auto   # heatmap block above left ytics pinned to the sweep list
# set logscale x 2
set xtics @tics_list rotate by -45
set format x "%g"
set format y "%g"
set grid ytics lc rgb '#e1e0d9'
set cbrange [word(sweep,1)+0 : word(sweep,words(sweep))+0]
set cbtics @tics_list

# ordinal multi-hue ramp, same hue order as the heatmap above, so 20 lines
# stay distinguishable instead of collapsing into similar blues
set palette defined (\
    0.00 '#3987e5', \
    0.25 '#1baf7a', \
    0.50 '#eda100', \
    0.75 '#eb6834', \
    1.00 '#e34948' \
)

# filter each curve by its -c value rather than relying on gnuplot's
# double-blank-line "index" dataset separator (results.dat only has single
# blank lines, needed as pm3d scan-line breaks for the heatmap above)
n = words(sweep)
plot for [i=0:n-1] 'results.dat' \
     using ($1 == word(sweep, i+1)+0 ? $2 : 1/0):3:(word(sweep, i+1)+0) \
     with lines lw 2 lc palette z
